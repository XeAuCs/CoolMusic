<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_cover"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_default_cover_image" />

    </androidx.cardview.widget.CardView>

    <!-- 左上角：歌单名称 -->
    <TextView
        android:id="@+id/tv_sheet_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/card_cover"
        android:layout_alignStart="@id/card_cover"
        android:layout_margin="8dp"
        android:textSize="22sp"
        android:text="民谣" />

    <!-- 右上角：歌曲数量 -->
    <TextView
        android:id="@+id/tv_song_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/tv_sheet_name"
        android:layout_alignEnd="@id/card_cover"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:textSize="15sp"
        android:text="99" />

    <ImageView
        android:id="@+id/iv_song_count"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignTop="@id/tv_song_count"
        android:layout_alignBottom="@id/tv_song_count"
        android:layout_toStartOf="@id/tv_song_count"
        android:layout_marginEnd="1dp"
        android:src="@drawable/icon_song_count" />

    <!-- 左下角：收藏图标 + 收藏数 -->
    <ImageView
        android:id="@+id/iv_favorite"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignBottom="@id/card_cover"
        android:layout_alignStart="@id/card_cover"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/icon_favorite" />

    <TextView
        android:id="@+id/tv_favorite_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/card_cover"
        android:layout_toEndOf="@id/iv_favorite"
        android:layout_marginStart="1dp"
        android:layout_marginBottom="8dp"
        android:textSize="15sp"
        android:text="999万" />

    <!-- 右下角：播放图标 + 播放数 -->
    <TextView
        android:id="@+id/tv_play_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/card_cover"
        android:layout_alignEnd="@id/card_cover"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:textSize="15sp"
        android:text="999万" />

    <ImageView
        android:id="@+id/iv_play"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignBottom="@id/card_cover"
        android:layout_toStartOf="@id/tv_play_count"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/icon_paly_music" />

</RelativeLayout>