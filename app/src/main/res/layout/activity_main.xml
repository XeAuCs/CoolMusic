<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_marginTop="80dp"
        android:src="@drawable/login" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="100dp"
        android:gravity="center|center_vertical|center_horizontal"
        android:text="橡木唱片"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
         />

    <EditText
        android:id="@+id/login_et_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:background="@drawable/edit_logon_bg"
        android:drawableLeft="@drawable/icon_login"
        android:drawablePadding="20dp"
        android:hint="请输入账号"
        android:padding="10dp"
        android:textColor="#B3FFFFFF"
        android:textColorHint="#F2F2F2" />

    <EditText
        android:id="@+id/login_et_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="50dp"
        android:background="@drawable/edit_logon_bg"
        android:drawableLeft="@drawable/icon_password"
        android:drawablePadding="20dp"
        android:hint="请输入密码"
        android:padding="10dp"
        android:textColor="#B3FFFFFF"
        android:textColorHint="#F2F2F2"
        android:inputType="numberPassword"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="50dp"
        android:orientation="horizontal"
        android:spacing="10dp">

        <Button
            android:id="@+id/login_btn_sign_in"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@drawable/button_logon_bg"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="登录"
            android:textColor="#E62C21" />

        <Button
            android:id="@+id/login_btn_sign_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:background="@drawable/button_logon_bg"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="注册"
            android:textColor="#E62C21" />
    </LinearLayout>

</LinearLayout>