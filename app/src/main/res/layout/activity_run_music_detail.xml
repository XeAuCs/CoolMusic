<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_run_music"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/test"
    tools:context=".activity.user.RunMusicDetailActivity">

    <!-- 上半部分内容（封面 + 歌曲信息） -->
    <LinearLayout
        android:id="@+id/content_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 专辑封面 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_music_cover"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="100dp"
            app:cardCornerRadius="140dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardPreventCornerOverlap="false">

            <ImageView
                android:id="@+id/iv_music_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/icon_default_cover_image" />
        </androidx.cardview.widget.CardView>

        <!-- 歌曲信息区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tv_music_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="遇见"
                android:textColor="@color/night_on_primary"
                android:textSize="20sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tv_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/iv_like"
                    android:layout_marginEnd="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="孙燕姿"
                    android:textColor="@color/night_on_primary"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/iv_like"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/icon_dislike" />
            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 歌词视图 - 独立在 ConstraintLayout 顶层，横向占满 -->
    <com.cool.music.view.LyricView
        android:id="@+id/lyric_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/content_area"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部固定面板：进度 + 时间 + 按钮 -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <SeekBar
            android:id="@+id/user_seekbar_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="300"
            android:progressTint="@color/player_progress"
            android:thumbTint="@color/player_progress"
            android:progressBackgroundTint="@color/player_progress_bg_night" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/user_tv_current_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="01:30"
                android:textSize="12sp"
                android:textColor="@color/night_text_secondary" />

            <TextView
                android:id="@+id/user_tv_total_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="04:25"
                android:textSize="12sp"
                android:textColor="@color/night_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/user_iv_recycle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="16dp"
                android:padding="10dp"
                android:src="@drawable/ic_recycle_play"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="循环播放" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/user_iv_previous"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="14dp"
                android:src="@drawable/ic_skip_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="上一首" />

            <ImageView
                android:id="@+id/user_iv_play"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="16dp"
                android:padding="12dp"
                android:src="@drawable/ic_play_arrow"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="播放" />

            <ImageView
                android:id="@+id/user_iv_next"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="14dp"
                android:src="@drawable/ic_skip_next"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="下一首" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/user_iv_playlist"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="16dp"
                android:padding="10dp"
                android:src="@drawable/ic_music_play_list"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="播放列表" />

        </LinearLayout>

    </LinearLayout>

    <!-- AudioVisualizerView -->
    <com.cool.music.view.AudioVisualizerView
        android:id="@+id/audio_visualizer"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>